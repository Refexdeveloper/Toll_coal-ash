# =============================================================================
# 3i Sales Funnel — client environment
# Copy this file to client/.env
# Never commit client/.env
# =============================================================================

# Leave VITE_API_URL empty when Express serves the built UI (SERVE_CLIENT=true).
# Same-origin /api/v1 is used in that case.

# Local Vite only (`cd client && npm run dev`):
# Vite proxies /api to this API port.
VITE_API_PORT=4090

# Optional absolute API URL (production / split hosting). Example:
# VITE_API_URL=https://your-api-host.example.com/api/v1
# VITE_API_URL=
