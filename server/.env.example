# =============================================================================
# 3i Sales Funnel — server environment
# Copy this file to server/.env and fill in local values.
# Never commit server/.env
# =============================================================================

PORT=4090
HOST=0.0.0.0
NODE_ENV=development

# Production: Express serves the built SPA from ../client/out on the same PORT
# Build first:  cd ../client && npm ci && npm run build
SERVE_CLIENT=true

FRONTEND_URL=http://localhost:4090
PUBLIC_APP_URL=http://localhost:4090
CLIENT_ORIGIN=http://localhost:4090,http://localhost:5173
FORCE_HTTPS=false

# Optional JSON body size (default 4mb)
# JSON_BODY_LIMIT=4mb

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=3i_Sales_funnel
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Use a long random string in any shared or production environment
JWT_SECRET=change_this_to_a_secure_random_string

# FASTag lookups. The token stays on the server and is sent as X-AT-AccessToken.
FASTAG_API_BASE=https://customer.ktt.io/refex/fastag
FASTAG_ACCESS_TOKEN=
# FASTAG_CONCURRENCY=4

# --- Email (optional — forgot-password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="3i Sales Funnel" <noreply@example.com>
